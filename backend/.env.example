# ────────────────────────────────────────────────────────────────────────────
#  PurePuff — Environment Variables Template
#  Copy to .env and fill in real values. NEVER commit .env to git.
# ────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/purepuff?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=7d

# ── Frontend URL (used for CORS + email verification links) ───────────────────
FRONTEND_URL=http://localhost:5173
# Production example:
# FRONTEND_URL=https://purepuff.in

# ── SMTP (Email verification) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=PurePuff <noreply@purepuff.in>

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
