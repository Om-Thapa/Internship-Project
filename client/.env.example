# ─────────────────────────────────────────────────────────────────────────────
#  PurePuff Frontend — Environment Variables
#  Copy to client/.env and fill in values. NEVER commit .env to git.
#  All variables must be prefixed with VITE_ to be exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────────────────────
# Backend base URL (without trailing slash)
VITE_API_URL=http://localhost:5000/api

# Production:
# VITE_API_URL=https://api.purepuff.in/api

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Public key only — NEVER put the secret here
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity Project ID
VITE_CLARITY_ID=xxxxxxxxxx
